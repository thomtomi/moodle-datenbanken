      "learning_objectives": [
        {
          "id": "df2fdefa-4bcd-4fc5-9af4-5a7e4b5c5819",
          "content_html": "die Eigenschaften des Lebendigen zu erläutern und diese anhand von Beispielen zu veranschaulichen."
        },
        {
          "id": "5cb3ac0c-8836-4b8b-bbd5-641ceeabbc08",
          "content_html": "die hierarchische Organisation der Biosysteme zu benennen."
        },
        {
          "id": "e5a28b8a-7ccb-4cec-9775-df88931b4a4a",
          "content_html": "grundlegende Fachbegriffe der Systematik zu verwenden."
        },
        {
          "id": "b6b68d2a-610a-40a5-8cd2-d51a36ea5dd4",
          "content_html": "einen Organismus den drei Domänen zuzuordnen und – falls er zur Domäne der Eukarya gehört – eine weitere Einteilung in die vier Reiche vorzunehmen."
        },
        {
          "id": "d86712dd-c9cc-4ef2-87ce-ee46c45c2665",
          "content_html": "die hierarchische Klassifikation (Domäne, Reich, Stamm, Klasse, Ordnung usw.) wiederzugeben."
        },
        {
          "id": "e34c4290-3940-4f0e-8b4d-a2eaedda8031",
          "content_html": "die grobe Funktion der genetischen Information für die Biologie und insbesondere für die Systematik zu erklären."
        },
        {
          "id": "75acca77-191d-42dc-b2bf-b308f6a4fcf6",
          "content_html": "anzugeben, welche Elemente häufig in Biomolekülen vorkommen (Makronährelemente) und welche zu den Spurenelementen (Mikronährelemente) zählen."
        },
        {
          "id": "5f4ed94a-a82f-408c-a2ca-5c4234796476",
          "content_html": "die chemischen und physikalischen Eigenschaften von Wasser zu beschreiben."
        }
      ],
